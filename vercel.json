{
  "rewrites": [
    {
      "source": "/review/:token",
      "destination": "/review/index.html"
    }
  ],
  "headers": [
    {
      "source": "/review/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    }
  ]
}
