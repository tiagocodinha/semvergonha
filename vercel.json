{
  "routes": [
    {
      "src": "/review(?:/.*)?",
      "headers": {
        "X-Robots-Tag": "noindex, nofollow, noarchive"
      },
      "continue": true
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/review/([^/]+)/?",
      "dest": "/review/index.html"
    },
    {
      "src": "/.*",
      "status": 302,
      "headers": {
        "Location": "https://www.semvergonharestaurant.com/"
      }
    }
  ]
}