{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "serve (static)",
      "runtimeExecutable": "C:\\PROGRA~1\\nodejs\\node.exe",
      "runtimeArgs": [
        "-e",
        "const h=require('http'),f=require('fs'),p=require('path'),m={'.html':'text/html','.css':'text/css','.js':'application/javascript','.png':'image/png','.jpg':'image/jpeg','.svg':'image/svg+xml','.ico':'image/x-icon'};h.createServer((q,r)=>{const u=q.url.split('?')[0],fp=p.join(process.cwd(),u==='/'?'index.html':u);f.readFile(fp,(e,d)=>{if(e){r.writeHead(404);r.end('Not found');}else{r.writeHead(200,{'Content-Type':m[p.extname(fp)]||'text/plain'});r.end(d);}});}).listen(3000,()=>console.log('Serving on http://localhost:3000'));"
      ],
      "port": 3000
    }
  ]
}
