{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "semvergonha",
      "runtimeExecutable": "node",
      "runtimeArgs": ["-e", "require('http').createServer((req,res)=>{const fs=require('fs'),path=require('path');let f=path.join(process.cwd(),req.url==='/'?'index.html':req.url);fs.readFile(f,(e,d)=>{if(e){res.writeHead(404);res.end();}else{const m={'html':'text/html','css':'text/css','js':'text/javascript','png':'image/png','jpg':'image/jpeg','svg':'image/svg+xml'};const ext=f.split('.').pop();res.writeHead(200,{'Content-Type':m[ext]||'text/plain'});res.end(d);}});}).listen(5050,()=>console.log('Server running'))"],
      "port": 5050
    }
  ]
}
